+"""Disposable Git workspace and harmless capability runner for shutdown verification."""
+
+from __future__ import annotations
+
+import json
+import shlex
+import subprocess
+import sys
+from pathlib import Path
+
+import yaml
+
+from guestspace_harness.capabilities import CapabilityExecutor
+from guestspace_harness.composite import CompositeWorkspaceCoordinator
+from guestspace_harness.git import GitClient
+from guestspace_harness.manifest import load_manifest
+from guestspace_harness.task_model import OperationStatus
+from guestspace_harness.task_store import TaskStore
+from guestspace_harness.tasks import TaskCoordinator
+
+
+def git(path: Path, *args: str) -> str:
+    return subprocess.run(
+        ["git", "-C", str(path), *args], check=True, capture_output=True, text=True
+    ).stdout
+
+
+class FakeShutdownRunner:
+    def __init__(self) -> None:
+        self.calls: list[Path] = []
+        self.failures: set[str] = set()
+
+    def __call__(self, command, *, cwd, **_kwargs):
+        self.calls.append(cwd)
+        failed = cwd.name in self.failures
+        return subprocess.CompletedProcess(
+            command,
+            1 if failed else 0,
+            json.dumps({"state": "shutdown", "running": False}) if not failed else "",
+            "fake cleanup failure" if failed else "",
+        )
+
+
+def create_shutdown_fixture(
+    root: Path,
+    *,
+    repositories: tuple[str, ...] = ("backend", "frontend"),
+) -> tuple[CompositeWorkspaceCoordinator, Path, FakeShutdownRunner]:
+    """Create only temporary Git repos; adapter commands write a local marker, never runtimes."""
+    primary = root.resolve() / "primary"
+    primary.mkdir(parents=True)
+    git(primary, "init", "-b", "main")
+    git(primary, "config", "user.name", "Shutdown fixture")
+    git(primary, "config", "user.email", "fixture@example.test")
+    (primary / "config").mkdir()
+    (primary / "bin").mkdir()
+    launcher = primary / "bin/guestspace"
+    entrypoint = (
+        "import sys; from pathlib import Path; from guestspace_harness.cli import main; "
+        "raise SystemExit(main(sys.argv[2:], repository_root=Path(sys.argv[1])))"
+    )
+    launcher.write_text(
+        "#!/bin/sh\nexec "
+        + shlex.join([sys.executable, "-c", entrypoint, str(primary)])
+        + ' "$@"\n'
+    )
+    launcher.chmod(0o755)
+    (primary / ".gitignore").write_text("projects/\ntasks/\n.guestspace/\nTASK.md\n")
+    (primary / "config/repositories.yaml").write_text(
+        yaml.safe_dump(
+            {
+                "schema_version": 1,
+                "workspace": {
+                    "name": "shutdown-fixture",
+                    "projects_path": "projects",
+                    "tasks_path": "tasks",
+                    "worktrees_path": "../worktrees",
+                    "clone_protocol": "ssh",
+                },
+                "repositories": {
+                    name: {
+                        "display_name": name.title(),
+                        "github": f"fixture/{name}",
+                        "path": name,
+                        "default_branch": "main",
+                        "role": name,
+                        "install": True,
+                        "tags": [],
+                    }
+                    for name in repositories
+                },
+            }
+        )
+    )
+    git(primary, "add", ".")
+    git(primary, "commit", "-m", "Fixture control plane")
+    for name in repositories:
+        project = primary / "projects" / name
+        project.mkdir(parents=True)
+        git(project, "init", "-b", "main")
+        git(project, "config", "user.name", "Shutdown fixture")
+        git(project, "config", "user.email", "fixture@example.test")
+        git(project, "remote", "add", "origin", f"git@github.com:fixture/{name}.git")
+        (project / ".guestspace").mkdir()
+        (project / ".gitignore").write_text(".guestspace/shutdown-called\n")
+        (project / "source.txt").write_text(f"preserve {name}\n")
+        capabilities = {}
+        for capability in ("runtime.status", "runtime.shutdown"):
+            script = "import json; print(json.dumps(dict(state='shutdown', running=False)))"
+            if capability == "runtime.shutdown":
+                script = (
+                    "from pathlib import Path; "
+                    "Path('.guestspace/shutdown-called').write_text('called'); " + script
+                )
+            capabilities[capability] = {
+                "command": ["python3", "-c", script],
+                "mode": "foreground",
+                "output": "json",
+                "placeholders": [],
+                "env_placeholders": [],
+                "endpoints": [],
+                "prerequisites": [],
+                "safety": "safe" if capability == "runtime.status" else "external",
+            }
+        (project / ".guestspace/project.yaml").write_text(
+            yaml.safe_dump({"schema_version": 1, "project_id": name, "capabilities": capabilities})
+        )
+        git(project, "add", ".")
+        git(project, "commit", "-m", "Fixture application adapter")
+    manifest = load_manifest(primary / "config/repositories.yaml", repository_root=primary)
+    store = TaskStore(manifest.workspace.tasks_path)
+    runner = FakeShutdownRunner()
+    tasks = TaskCoordinator(manifest, store, git=GitClient(), executor=CapabilityExecutor(runner))
+    coordinator = CompositeWorkspaceCoordinator(manifest, store, tasks=tasks)
+    created = coordinator.create("Shutdown fixture", task_id="20260907-shutdown-fixture-abc123")
+    assert created.status is OperationStatus.OK, created.to_dict()
+    outer = Path(created.details["workspace_path"])
+    for name in repositories:
+        added = coordinator.add_repository(created.task_id, name)
+        assert added.status is OperationStatus.OK, added.to_dict()
+    runner.calls.clear()
+    return coordinator, outer, runner
