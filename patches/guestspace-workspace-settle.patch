+                    binding.repository_id,
+                    "runtime.shutdown",
+                    environment=environment,
+                    expected_binding=binding,
+                )
+                if not isinstance(result, OperationResult):
+                    raise TaskError("runtime.shutdown did not return an operation result")
+            except (TaskError, GitFailure, WorkspacePathError, OSError) as error:
+                result = OperationResult(
+                    "runtime.shutdown",
+                    OperationStatus.FAILED,
+                    task.id,
+                    "shutdown_failed",
+                    {"reason": str(error)},
+                )
+            item = result.to_dict()
