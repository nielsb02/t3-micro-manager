+            binding.worktree_path != str(expected)
+            or expected.resolve() != expected
+            or not self.git.is_worktree_root(expected)
+        ):
+            raise TaskError("bound worktree must be at this workspace's projects/<repository-id>")
+        owners = [item for item in claims if item["canonical_path"] == str(expected)]
+        if len(owners) != 1 or any(
+            owner["task_id"] != task.id
+            or owner["repository_id"] != binding.repository_id
+            or owner["ownership"] != Ownership.MANAGED.value
+            for owner in owners
+        ):
+            raise TaskError("bound worktree lacks an exclusive managed claim for this task")
+        manager = WorktreeManager(
+            self.git,
+            repository.target_path(self.manifest.workspace.projects_path),
+            repository.github,
+        )
