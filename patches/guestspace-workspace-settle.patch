+    def _shutdown_task(self, outer: Path) -> Task:
+        if not self.git.is_worktree_root(outer):
+            raise TaskError("shutdown requires the root of a linked composite workspace")
+        checkout = resolve_workspace_checkout(outer, self.git)
+        if not checkout.is_linked or checkout.primary_root != self.manifest.root.resolve():
+            raise TaskError("shutdown requires a linked checkout of this primary workspace")
+        records = parse_worktree_porcelain(self.git.worktree_porcelain(self.manifest.root))
+        if not any(
+            record.path.resolve() == outer and not record.bare and not record.prunable
+            for record in records
+        ):
+            raise TaskError("workspace is not a registered linked worktree")
+        if (
+            self._has_symlinked_local_state(outer)
+            or (outer / ".guestspace" / "workspace.json").is_symlink()
+        ):
+            raise TaskError("shutdown refuses symlinked workspace state")
+        identity = self.identity(outer)
+        if identity is None:
+            raise TaskError("workspace is not initialized; workspace.json is required")
+        task = self.store.task_for_workspace(outer)
+        if task is None or task.id != identity.task_id:
+            raise TaskError("workspace identity does not match its canonical task record")
+        return task
+
+    def _validate_shutdown_binding(
