+def test_shutdown_delegates_all_repositories_and_preserves_dirty_source_and_worktrees(
+    tmp_path: Path,
+) -> None:
+    coordinator, outer, runner = create_shutdown_fixture(tmp_path)
+    before = git(coordinator.manifest.root, "worktree", "list", "--porcelain")
+    source = outer / "projects/backend/source.txt"
+    source.write_text("valuable uncommitted work\n")
+    before_repositories = {
+        name: git(outer / "projects" / name, "status", "--porcelain")
+        for name in ("backend", "frontend")
+    }
+
+    result = coordinator.shutdown(outer)
+
+    assert result.status is OperationStatus.OK
+    assert runner.calls == [outer / "projects/backend", outer / "projects/frontend"]
+    assert source.read_text() == "valuable uncommitted work\n"
+    assert git(coordinator.manifest.root, "worktree", "list", "--porcelain") == before
+    for name in ("backend", "frontend"):
+        assert git(outer / "projects" / name, "status", "--porcelain") == before_repositories[name]
+        assert (outer / "projects" / name / ".git").is_file()
+    lock = coordinator.store.load_lock(result.task_id)
+    assert lock.observed["runtime_states"] == {"backend": "stopped", "frontend": "stopped"}
+    assert coordinator.shutdown(outer).status is OperationStatus.OK
+
+
+def test_shutdown_continues_after_repository_failure_and_reports_each_result(
+    tmp_path: Path,
+) -> None:
+    coordinator, outer, runner = create_shutdown_fixture(tmp_path)
+    runner.failures.add("backend")
+
+    result = coordinator.shutdown(outer)
+
+    assert result.status is OperationStatus.FAILED
+    assert result.error_code == "repository_shutdown_failed"
+    assert len(runner.calls) == 2
+    assert [item["status"] for item in result.details["repositories"]] == ["failed", "ok"]
+    failed = result.details["repositories"][0]
+    assert failed["details"]["repository_id"] == "backend"
+    assert failed["error_code"] == "command_failed"
+    assert Path(failed["details"]["evidence_path"]).is_file()
+
