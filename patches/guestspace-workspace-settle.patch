+        except (TaskError, GitFailure, WorkspacePathError, OSError) as error:
+            return OperationResult(
+                "workspace.shutdown",
+                OperationStatus.CONFLICT,
+                error_code="unsafe_workspace",
+                details={"workspace_path": str(outer), "reason": str(error)},
+            )
+
+        failures = []
+        for binding in task.bindings:
+            try:
+                self._validate_shutdown_binding(task, binding, outer, claims)
+            except (TaskError, GitFailure, OSError) as error:
+                failures.append(
+                    OperationResult(
+                        "runtime.shutdown",
+                        OperationStatus.CONFLICT,
+                        task.id,
+                        "unsafe_repository_binding",
+                        {"repository_id": binding.repository_id, "reason": str(error)},
+                    ).to_dict()
+                )
+        if failures:
+            return OperationResult(
+                "workspace.shutdown",
+                OperationStatus.CONFLICT,
+                task.id,
+                "unsafe_repository_binding",
+                {"workspace_path": str(outer), "repositories": failures},
+            )
+
+        results = []
