+def test_shutdown_preflights_all_bindings_before_any_runtime_call(
+    tmp_path: Path, unsafe: str
+) -> None:
+    coordinator, outer, runner = create_shutdown_fixture(tmp_path)
+    task = coordinator.store.task_for_workspace(outer)
+    binding = task.bindings[1]
+    path = Path(binding.worktree_path)
+    if unsafe in {"attached", "outside", "primary"}:
+        changed = replace(
+            binding,
+            ownership=Ownership.ATTACHED if unsafe == "attached" else binding.ownership,
+            worktree_path=(
+                str(tmp_path / "external")
+                if unsafe == "outside"
+                else str(coordinator.manifest.root / "projects/frontend")
+                if unsafe == "primary"
+                else binding.worktree_path
+            ),
+        )
+        lock = coordinator.store.load_lock(task.id)
+        coordinator.store.mutate(
+            task.id,
+            lock.revision,
+            lambda task, lock: (
+                replace(task, bindings=(task.bindings[0], changed)),
+                replace(lock, revision=lock.revision + 1),
+            ),
+        )
+    elif unsafe in {"missing-claim", "shared"}:
+        coordinator.store.release_worktree(task.id, binding.repository_id, path)
+        if unsafe == "shared":
+            coordinator.store.claim_worktree(
+                "20260907-other-task-abc123", binding.repository_id, path
+            )
+    elif unsafe == "branch":
+        git(path, "checkout", "-b", "other-branch")
+    elif unsafe == "lock":
+        git(path, "worktree", "unlock", str(path))
+    else:
+        git(path, "remote", "set-url", "origin", "git@github.com:other/project.git")
+
+    result = coordinator.shutdown(outer)
+
+    assert result.status is OperationStatus.CONFLICT
+    assert result.error_code == "unsafe_repository_binding"
+    assert runner.calls == []
+    assert result.details["repositories"][-1]["details"]["repository_id"] == "frontend"
