+    def uncertain(task_id, repository_id, capability, **kwargs):
+        if repository_id == "backend":
+            return False
+        return original(task_id, repository_id, capability, **kwargs)
+
+    monkeypatch.setattr(coordinator.tasks, "run_capability", uncertain)
+
+    result = coordinator.shutdown(outer)
+
+    assert result.status is OperationStatus.FAILED
+    assert result.details["repositories"][0]["error_code"] == "shutdown_failed"
+    assert runner.calls == [outer / "projects/frontend"]
+
+
+def test_shutdown_rechecks_claims_after_an_earlier_repository_finishes(
+    tmp_path: Path, monkeypatch: pytest.MonkeyPatch
+) -> None:
+    coordinator, outer, runner = create_shutdown_fixture(tmp_path)
+    original = coordinator.tasks.run_capability
+
+    def release_next_claim(task_id, repository_id, capability, **kwargs):
+        result = original(task_id, repository_id, capability, **kwargs)
+        if repository_id == "backend":
+            next_path = outer / "projects/frontend"
+            coordinator.store.release_worktree(task_id, "frontend", next_path)
+            coordinator.store.claim_worktree("20260907-other-task-abc123", "frontend", next_path)
+        return result
+
+    monkeypatch.setattr(coordinator.tasks, "run_capability", release_next_claim)
+
+    result = coordinator.shutdown(outer)
+
+    assert result.status is OperationStatus.FAILED
+    assert result.details["repositories"][0]["status"] == "ok"
+    assert "exclusive managed claim" in result.details["repositories"][1]["details"]["reason"]
+    assert runner.calls == [outer / "projects/backend"]
+
+
+def test_actual_cli_process_can_shutdown_disposable_workspace_without_runtime_resources(
+    tmp_path: Path,
+) -> None:
+    coordinator, outer, _runner = create_shutdown_fixture(tmp_path)
+
+    completed = subprocess.run(
+        [
+            str(coordinator.manifest.root / "bin/guestspace"),
+            "workspace",
+            "shutdown",
+            str(outer),
+            "--json",
+        ],
+        check=False,
+        capture_output=True,
+        text=True,
+        env={**os.environ, "PATH": "/usr/bin:/bin"},
+    )
+
+    assert completed.returncode == 0, (completed.stdout, completed.stderr)
+    result = json.loads(completed.stdout)
+    assert result["status"] == "ok"
+    assert [item["status"] for item in result["details"]["repositories"]] == ["ok", "ok"]
+    for repository in ("backend", "frontend"):
+        assert (
+            outer / "projects" / repository / ".guestspace/shutdown-called"
+        ).read_text() == "called"
+        assert (
+            outer / "projects" / repository / "source.txt"
+        ).read_text() == f"preserve {repository}\n"
